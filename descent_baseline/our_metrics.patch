diff --git a/descent/utils/our_metrics.py b/descent/utils/our_metrics.py
new file mode 100644
index 0000000..4e8ad65
--- /dev/null
+++ b/descent/utils/our_metrics.py
@@ -0,0 +1,153 @@
+"""Max-probability-selection metrics (RMSE, NLL, PADE, PFDE), ported verbatim from our own
+Amelia-TF-derived evaluation code (AmeliaTF_main/amelia_tf/utils/metrics.py) so DESCENT's results
+use the exact same formulas/conventions as our other baselines (STGCNN, Amelia-TF, TP).
+
+DESCENT's own minADE/minFDE (oracle, best-of-H) are already computed and logged by
+descent.models.trajpred.TrajPred; this file only adds the metrics that are missing: everything
+that depends on *which* candidate the predicted mode scores actually pick, rather than the best
+one in hindsight.
+
+Shapes follow descent.models.trajpred.TrajPred.model_step's outputs after separate_ego_agent and
+horizon-slicing: Y_hat/sigma (B, 1, T, H, D), pred_scores (B, 1, H) *already softmaxed*, Y (B, 1, T,
+D), mask (B, 1, T). The leading "agent" dim (A=1, the ego agent only) is carried through unchanged;
+these functions are agent-count-agnostic.
+"""
+
+import torch
+
+
+def compute_nll(
+    Y_hat: torch.Tensor, sigma: torch.Tensor, pred_scores: torch.Tensor,
+    Y: torch.Tensor, mask: torch.Tensor = None,
+) -> torch.Tensor:
+    """Multi-modal Gaussian-mixture negative log-likelihood.
+
+    Args:
+        Y_hat: [B, A, T_total, H, D] predicted trajectory means (only last T used).
+        sigma: [B, A, T_total, H, D] predicted per-coordinate VARIANCE (only last T used).
+            DESCENT's own decoder names this "sigma" but feeds it unmodified as the `var`
+            argument of torch.nn.functional.gaussian_nll_loss, whose docs specify that
+            argument must already be a variance -- so despite the name, this is not a std
+            dev, and must not be squared again here.
+        pred_scores: [B, A, H] mixture weights (already softmax-normalised probabilities).
+        Y: [B, A, T, D] ground-truth future trajectories.
+        mask: [B, A, T_total] agent validity mask (only last T steps used).
+
+    Returns:
+        nll: [B, A] negative log-likelihood for each agent.
+    """
+    B, A, T, D = Y.size()
+
+    diff = Y[..., None, :] - Y_hat[..., -T:, :, :]  # [B, A, T, H, D]
+    var = sigma[..., -T:, :, :].clamp_min(1e-6)
+    logp_mode = -0.5 * (torch.log(2 * torch.pi * var) + diff.pow(2) / var)
+    logp_mode = logp_mode.sum(dim=-1)  # [B, A, T, H]
+
+    log_pi = torch.log(pred_scores.clamp_min(1e-8))  # [B, A, H]
+    logp_mix = logp_mode + log_pi[:, :, None, :]  # [B, A, T, H]
+
+    logp_t = torch.logsumexp(logp_mix, dim=-1)  # [B, A, T]
+    nll_t = -logp_t
+
+    if mask is None:
+        nll = nll_t.mean(dim=-1)
+    else:
+        mask_pred = mask[:, :, -T:]
+        nll = (nll_t * mask_pred).sum(dim=-1) / mask_pred.sum(dim=-1).clamp_min(1)
+    return nll
+
+
+def compute_mode_rmse(
+    Y_hat: torch.Tensor, pred_scores: torch.Tensor, Y: torch.Tensor,
+    mask: torch.Tensor = None, scale: float = 1000.0,
+) -> torch.Tensor:
+    """RMSE of the highest-probability trajectory.
+
+    Args:
+        Y_hat: [B, A, T_total, H, D] predicted trajectories (only last T steps used).
+        pred_scores: [B, A, H] mode probabilities.
+        Y: [B, A, T, D] ground-truth future trajectories.
+        mask: [B, A, T_total] agent validity mask (only last T steps used).
+        scale: unit conversion (km to m).
+
+    Returns:
+        rmse: [B, A] RMSE for each agent using its highest-probability trajectory.
+    """
+    B, A, T, D = Y.size()
+
+    prob_max_idx = pred_scores.argmax(dim=-1, keepdim=True)  # [B, A, 1]
+    best_traj = torch.gather(
+        Y_hat[..., -T:, :, :], 3,
+        prob_max_idx.unsqueeze(2).unsqueeze(-1).expand(-1, -1, T, 1, D),
+    )[..., 0, :]  # [B, A, T, D]
+
+    error_sq = ((best_traj - Y).norm(dim=-1)).pow(2)
+    if mask is None:
+        error_sq = error_sq.mean(dim=2)
+    else:
+        mask = mask[:, :, -T:]
+        error_sq = error_sq.view(B * A, T)
+        BA, T_ = error_sq.shape
+        mask = mask.view(BA, T_)
+        error_masked = torch.zeros(BA, device=error_sq.device)
+        for ba in range(BA):
+            amask = mask[ba]
+            error_masked[ba] = error_sq[ba, amask].mean(dim=0)
+        error_sq = error_masked.view(B, A)
+
+    rmse = torch.sqrt(error_sq)
+    return scale * rmse
+
+
+def mode_ade(
+    Y_hat: torch.Tensor, pred_scores: torch.Tensor, Y: torch.Tensor,
+    mask: torch.Tensor = None, scale: float = 1000.0,
+) -> torch.Tensor:
+    """Average displacement error of the highest-probability trajectory (our "PADE")."""
+    B, A, T, D = Y.size()
+
+    prob_max_idx = pred_scores.argmax(dim=-1, keepdim=True)  # [B, A, 1]
+    best_traj = torch.gather(
+        Y_hat[..., -T:, :, :], 3,
+        prob_max_idx.unsqueeze(2).unsqueeze(-1).expand(-1, -1, T, 1, D),
+    )[..., 0, :]  # [B, A, T, D]
+
+    error = (best_traj - Y).norm(dim=-1)  # [B, A, T]
+    if mask is None:
+        ade = error.mean(dim=-1)
+    else:
+        mask_pred = mask[:, :, -T:]
+        ade = (error * mask_pred).sum(dim=-1) / mask_pred.sum(dim=-1).clamp_min(1)
+    return scale * ade
+
+
+def mode_fde(
+    Y_hat: torch.Tensor, pred_scores: torch.Tensor, Y: torch.Tensor,
+    mask: torch.Tensor = None, scale: float = 1000.0,
+) -> torch.Tensor:
+    """Final displacement error of the highest-probability trajectory (our "PFDE")."""
+    B, A, T, D = Y.size()
+
+    prob_max_idx = pred_scores.argmax(dim=-1, keepdim=True)  # [B, A, 1]
+
+    if mask is None:
+        best_traj_final = torch.gather(
+            Y_hat[..., -1:, :, :], 2,
+            prob_max_idx.unsqueeze(2).unsqueeze(-1).expand(-1, -1, 1, 1, D),
+        )[..., 0, :]
+        best_traj_final = best_traj_final.squeeze(2)
+        Y_final = Y[..., -1, :]
+        error = (best_traj_final - Y_final).norm(dim=-1)
+    else:
+        mask_pred = mask[:, :, -T:]
+        last_valid_idx = (mask_pred != 0).cumsum(dim=-1).argmax(dim=-1)  # [B, A]
+        b_idx, a_idx = torch.meshgrid(
+            torch.arange(B, device=Y.device), torch.arange(A, device=Y.device), indexing="ij"
+        )
+        Y_final = Y[b_idx, a_idx, last_valid_idx]  # [B, A, D]
+        Y_hat_final_all_modes = Y_hat[..., -T:, :, :][b_idx, a_idx, last_valid_idx, :, :]  # [B,A,H,D]
+        best_traj_final = torch.gather(
+            Y_hat_final_all_modes, 2, prob_max_idx.unsqueeze(-1).expand(-1, -1, 1, D),
+        )[..., 0, :]
+        error = (best_traj_final - Y_final).norm(dim=-1)
+    return scale * error
